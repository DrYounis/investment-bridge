# ===========================================
# Investment Bridge - Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ===========================================
# Supabase Configuration
# ===========================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# Strava API Configuration
# ===========================================
# Get your credentials from: https://www.strava.com/settings/api
# 1. Create an application
# 2. Set Authorization Callback Domain to your production domain
# 3. Copy Client ID and Client Secret below
STRAVA_CLIENT_ID=your_strava_client_id
STRAVA_CLIENT_SECRET=your_strava_client_secret

# For local development:
NEXT_PUBLIC_STRAVA_REDIRECT_URI=http://localhost:3000/api/strava/callback

# For production, update to:
# NEXT_PUBLIC_STRAVA_REDIRECT_URI=https://yourdomain.com/api/strava/callback

# ===========================================
# Resend Email Configuration
# ===========================================
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key

# Email address for admin notifications
ADMIN_EMAIL=your_admin_email@example.com

# ===========================================
# Sentry Error Monitoring (Optional)
# ===========================================
# Get your DSN from: https://sentry.io/settings/
# Create account and project at: https://sentry.io/signup/
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project

# ===========================================
# Cron Job Secret (Optional)
# ===========================================
# Used to secure the daily news scraping cron endpoint
CRON_SECRET=your_cron_secret_token
# Set to 'false' to disable rate limiting (default: enabled)
RATE_LIMIT_ENABLED=true

# ===========================================
# Test User Credentials (For Development)
# ===========================================
# These are used by scripts/create_test_*.js
# NEVER use these in production
TEST_ADMIN_EMAIL=admin.test@gmail.com
TEST_ADMIN_PASSWORD=your_secure_test_password
TEST_ENTREPRENEUR_EMAIL=test.entrepreneur@gmail.com
TEST_ENTREPRENEUR_PASSWORD=your_secure_test_password
TEST_ENTREPRENEUR_NAME=Test Entrepreneur
TEST_ENTREPRENEUR_PHONE=0588888888
TEST_ENTREPRENEUR_SECTOR=Technology
TEST_INVESTOR_EMAIL=test.investor@gmail.com
TEST_INVESTOR_PASSWORD=your_secure_test_password
TEST_INVESTOR_NAME=Test Investor
TEST_INVESTOR_PHONE=0599999999
TEST_INVESTOR_CR=999
