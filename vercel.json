{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "git": {
    "deploymentEnabled": {
      "main": true
    }
  },
  "crons": [
    {
      "path": "/api/cron/daily",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/weekly-meeting-notification",
      "schedule": "0 16 * * 0"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 6 * * 0"
    },
    {
      "path": "/api/cron/refresh-jobs",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/majlis-quiz-reminder",
      "schedule": "0 16 * * 6"
    },
    {
      "path": "/api/cron/glossary-term-of-week",
      "schedule": "0 5 * * 1"
    },
    {
      "path": "/api/cron/user-journey-analysis",
      "schedule": "0 8 * * 0"
    },
    {
      "path": "/api/cron/reengagement",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/cron/majlis-quiz-reminder-midweek",
      "schedule": "0 5 * * 3"
    }
  ]
}
